# Backend: copy to backend/.env. All paid capabilities disabled.
ENVIRONMENT=local
DATABASE_PATH=data/lazy-capitalist.db
AI_PROVIDER=mock
ALLOW_PAID_AI=false
JOB_BUDGET_USD=0
DAILY_BUDGET_USD=0
MONTHLY_BUDGET_USD=0
LIFETIME_BUDGET_USD=0
REQUEST_RESERVATION_USD=0
INPUT_USD_PER_MILLION=0
OUTPUT_USD_PER_MILLION=0
OPENAI_MODEL=gpt-4.1-mini
# Set only after owner approval; never commit secrets.
# OPENAI_API_KEY=
# API_TOKEN=at-least-32-random-characters-for-production
# Frontend: set separately in frontend/.env.local (server-only).
# BACKEND_URL=http://127.0.0.1:8000
# BACKEND_API_TOKEN=match-backend-api-token

# Protected local Desktop callback is mock-tested; live Google remains disabled.
YOUTUBE_ENABLED=false
# YOUTUBE_TOKEN_KEY=  # Fernet key from protected server secret storage, never committed
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/oauth/youtube/callback

# Local in-process reports; no live delivery providers exist.
REPORTING_SCHEDULER_ENABLED=true
